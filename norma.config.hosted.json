    "sourceUrl": "https://github.com/PavlopoulosLab/NORMA",
    "licenceName": "MIT License",
    "licenceUrl": "https://opensource.org/licenses/MIT",
    "privacyUrl": "",
    "imprintUrl": "",
    "maintainedUntil": "2031",
    "notice": "",
    "testedBrowsers": ["Chrome", "Firefox", "Safari", "Edge"]
  },
  "app": { "maxNodes": 5000, "theme": "white", "startTab": "welcome", "cdnFallback": false }
